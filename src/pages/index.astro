---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { SITE } from '../data/site';
import { getPosts, getProjects } from '../utils/posts';

const projects = (await getProjects()).filter((p) => p.data.featured).slice(0, 6);
const posts = (await getPosts()).slice(0, 3);
---

<BaseLayout wide>
  <section class="hero">
    <h1 class="page-title">Hi, I'm Jun</h1>
    <p class="lede">
      I'm a Computer Science major and Physics minor at Hamilton College who likes building things:
      VEX robots, 3D prints, Game Boy games, and technical tutorials.{' '}
      <strong>{SITE.title}</strong> is where I upload everything I've built and how I did it.
    </p>
    <p class="why meta">
      In 3D printing, the first layer decides whether the whole print succeeds. Learning works the same way.
    </p>
  </section>

  <div class="section-head">
    <h2>Projects</h2>
    <a href="/projects/">All projects →</a>
  </div>
  <div class="grid projects">
    {projects.map((project) => <ProjectCard project={project} />)}
  </div>

  {posts.length > 0 && (
    <>
      <div class="section-head">
        <h2>Latest posts</h2>
        <a href="/posts/">All posts →</a>
      </div>
      {posts.map((post) => <PostCard post={post} />)}
    </>
  )}
</BaseLayout>

<style>
  .hero { max-width: var(--max); padding-block: 1rem 0.5rem; }
  .lede { font-size: 1.2rem; margin-top: 1.25rem; }
  .why { font-style: italic; }
  .projects { margin-top: 1.25rem; }
</style>
