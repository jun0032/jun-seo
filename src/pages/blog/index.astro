---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getBlogPosts } from '../../utils/posts';

const posts = await getBlogPosts();
---

<BaseLayout title="Blog" description="Notes on whatever I'm into lately: climbing, games, school, and side projects.">
  <h1 class="page-title">Blog</h1>
  <p class="page-intro">Shorter notes on whatever I'm into lately: climbing, games, school, and side projects.</p>

  {posts.length ? posts.map((post) => <PostCard post={post} />) : <p class="meta">No posts yet. Check back soon.</p>}
</BaseLayout>
