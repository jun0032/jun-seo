---
import BaseLayout from './BaseLayout.astro';
import TagList from '../components/TagList.astro';
import { formatDate, type Post } from '../utils/posts';
import { readingTime } from '../utils/readingTime';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, description, date, updated, tags, type } = post.data;
const typeLabel = type === 'tutorial' ? 'Tutorial' : 'General';
---

<BaseLayout title={title} description={description}>
  <article>
    <header>
      <p class="meta">
        <a href="/posts/">← All posts</a> · <a href={`/posts/#${type}`}>{typeLabel}</a>
      </p>
      <h1 class="page-title">{title}</h1>
      <p class="meta">
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        {updated && <> · updated <time datetime={updated.toISOString()}>{formatDate(updated)}</time></>}
        · {readingTime(post.body)}
        {post.data.draft && <> · <strong>DRAFT</strong></>}
      </p>
      <TagList tags={tags} />
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  header { margin-bottom: 2.5rem; }
  header .meta { margin: 0.5rem 0; }
</style>
