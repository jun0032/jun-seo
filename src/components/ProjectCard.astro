---
import { Image } from 'astro:assets';
import placeholder from '../assets/placeholder.svg';
import { projectUrl, type Project } from '../utils/posts';

interface Props {
  project: Project;
  // h2 when the card sits right under the page's h1, h3 when under a section h2.
  headingLevel?: 2 | 3;
}

const { project, headingLevel = 3 } = Astro.props;
const { title, description, tech, github, demo, cover, date, categories, draft } = project.data;
const Heading = `h${headingLevel}`;
const href = projectUrl(project);
---

<article class="project-card" data-filters={categories.join(' ')}>
  <a href={href} tabindex="-1" aria-hidden="true">
    {cover ? (
      <Image src={cover} alt="" widths={[400, 800]} sizes="(max-width: 40rem) 100vw, 22rem" />
    ) : (
      <img class="placeholder" src={placeholder.src} alt="" width="640" height="360" />
    )}
  </a>
  <div class="body">
    <Heading class="title"><a href={href}>{title}</a></Heading>
    {(date || draft) && <p class="meta">{date}{draft && <strong> DRAFT</strong>}</p>}
    <p class="desc">{description}</p>
    {tech.length > 0 && (
      <ul class="tags" aria-label="Tech used">
        {tech.map((t) => <li><span class="tag">{t}</span></li>)}
      </ul>
    )}
    {(github || demo) && (
      <p class="links">
        {github && <a href={github}>GitHub ↗</a>}
        {demo && <a href={demo}>Live demo ↗</a>}
      </p>
    )}
  </div>
</article>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }
  img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-bottom: 1px solid var(--border);
  }
  .body { padding: 1rem 1.15rem 1.25rem; display: flex; flex-direction: column; flex: 1; }
  .title { margin: 0 0 0.2rem; font-size: 1.2rem; }
  .title a { color: var(--text); text-decoration: none; }
  .title a:hover { color: var(--accent); }
  .meta { margin: 0 0 0.5rem; }
  .desc { margin: 0 0 0.85rem; color: var(--muted); }
  .links { display: flex; gap: 1rem; margin: auto 0 0; padding-top: 0.85rem; font-weight: 600; }
</style>
